# Local development values only. Change the password before exposing the database.
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=job_agent
# Optional: use the Docker Postgres database instead of the local file in config/settings.yaml.
# DATABASE_URL=postgresql+psycopg://job_agent:change-me-for-local-development@localhost:5432/job_agent
ANTHROPIC_API_KEY=#INSERT KEY
# Optional: resume PDF used by job-apply, relative to the project root.
RESUME_PATH=profile/resume.pdf
# Optional: the resume builder's master CV (every activity it may pick from), and the
# one-page resume whose look (font, size, section headings) each tailored resume copies.
# MASTER_CV_PATH=profile/master_cv.pdf
# RESUME_FORMAT_PATH=profile/resume.pdf
